# =====================================================
# Claims Intake Pro - Environment Configuration
# =====================================================
# Copy this file to .env and update with your values

# Node Environment
NODE_ENV=production

# =====================================================
# Database Configuration (PostgreSQL)
# =====================================================
POSTGRES_USER=claims_user
POSTGRES_PASSWORD=claims_password
POSTGRES_DB=claims_intake

# Database Connection URL (used by Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://claims_user:claims_password@postgres:5432/claims_intake

# =====================================================
# Backend Configuration
# =====================================================
PORT=3001

# Scraper Schedule (Cron format)
# Default: Every hour (0 * * * *)
# Examples:
#   - Every hour: 0 * * * *
#   - Every 6 hours: 0 */6 * * *
#   - Every day at midnight: 0 0 * * *
#   - Every 30 minutes: */30 * * * *
SCRAPER_CRON=0 * * * *

# =====================================================
# Frontend Configuration
# =====================================================
# API Base URL (used by frontend)
VITE_API_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001/api

# =====================================================
# Optional: External Database Access
# =====================================================
# If you need to connect from outside Docker, use:
# DATABASE_URL=postgresql://claims_user:claims_password@localhost:5433/claims_intake
